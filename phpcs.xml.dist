<?xml version="1.0"?>
<ruleset name="Odds Aggregator">
	<description>Coding standard for the Odds Aggregator plugin.</description>

	<file>odds-aggregator.php</file>
	<file>src</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<!-- Defines stand-ins for WordPress functions; intentionally unprefixed. -->
	<exclude-pattern>tests/bootstrap.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- PSR-4 autoloading: filenames are ClassName.php, not class-name.php. -->
		<exclude name="WordPress.Files.FileName"/>

		<!--
			Exception messages are caught and logged, never echoed. Escaping them
			would corrupt the diagnostics without preventing any output.
		-->
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>

		<!--
			Properties on third-party objects (DOMNode::$textContent and friends)
			are named by PHP, not by us, so snake_case cannot apply.
		-->
		<exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
	</rule>

	<!--
		Tests read saved fixtures off disk. This sniff is aimed at fetching
		remote URLs, which is what wp_remote_get() is for; src/ still obeys it.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="6.3"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="odds-aggregator"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="odds_aggregator"/>
				<element value="OddsAggregator"/>
				<element value="ODDS_AGGREGATOR"/>
			</property>
		</properties>
	</rule>
</ruleset>
